FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . .
RUN dotnet publish src/examples/Streams/BroadcastHubScale/BroadcastHubScale.Broadcaster/BroadcastHubScale.Broadcaster.csproj -c Release -o /out /p:UseSharedCompilation=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /out .
EXPOSE 7000 8080
ENTRYPOINT ["dotnet", "BroadcastHubScale.Broadcaster.dll"]
