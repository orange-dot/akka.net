FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . .
RUN dotnet publish src/examples/Streams/BroadcastHubScale/BroadcastHubScale.Consumer/BroadcastHubScale.Consumer.csproj -c Release -o /out /p:UseSharedCompilation=false

FROM mcr.microsoft.com/dotnet/runtime:10.0
WORKDIR /app
COPY --from=build /out .
ENTRYPOINT ["dotnet", "BroadcastHubScale.Consumer.dll"]
